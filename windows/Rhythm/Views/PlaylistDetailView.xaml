<UserControl
    x:Class="Rhythm.Views.PlaylistDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Margin="12,8">
            <Button Click="OnBackClick">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock x:Name="playlistTitle" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="btnImport" Click="OnImportClick" Content="导入 m3u8"
                    Margin="16,0,0,0" />
            <Button x:Name="btnExport" Click="OnExportClick" Content="导出 m3u8" />
        </StackPanel>

        <ListView x:Name="trackList" Grid.Row="1"
                  SelectionMode="Single"
                  ItemClick="OnTrackClick"
                  IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource RhythmTextPrimaryBrush}" />
                            <TextBlock Text="{Binding Artist}"
                                       FontSize="11"
                                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="4,1" Margin="4,0"
                                CornerRadius="3"
                                Background="{Binding SourceBackgroundBrush}">
                            <TextBlock Text="{Binding SourceTag}" FontSize="10"
                                       Foreground="{Binding SourceColor}" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}"
                                   FontSize="12" Margin="4,0"
                                   Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
