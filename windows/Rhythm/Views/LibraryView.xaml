<Page
    x:Class="Rhythm.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Rhythm.Models"
    xmlns:views="using:Rhythm.Views">

    <Page.Resources>
        <!-- #516: radio buttons, so assistive technology reads which
             segment is selected, with pointer-over and pressed states in
             palette brushes; the checked one still comes from the view state. -->
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource RhythmHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource RhythmPressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentBackStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="SegmentBackSelectedStyle" TargetType="Border"
               BasedOn="{StaticResource SegmentBackStyle}">
            <Setter Property="Background" Value="{ThemeResource RhythmSelectionBrush}" />
        </Style>
        <Style x:Key="SegmentLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource RhythmTextPrimaryBrush}" />
        </Style>
        <Style x:Key="SegmentLabelSelectedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource RhythmAccentBrush}" />
        </Style>

        <!-- #520: an index entry is plain text, as macOS draws its index
             with a plain button style. -->
        <Style x:Key="LetterIndexButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource RhythmAccentBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <views:LibraryTemplateSelector x:Key="LibraryTemplates">
            <views:LibraryTemplateSelector.HeaderTemplate>
                <DataTemplate x:DataType="models:LibraryHeaderItem">
                    <TextBlock Text="{x:Bind Title}" Margin="0,10,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
                </DataTemplate>
            </views:LibraryTemplateSelector.HeaderTemplate>
            <views:LibraryTemplateSelector.AlbumTemplate>
                <DataTemplate x:DataType="models:AlbumGroupItem">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4,8,0">
                        <Border Width="48" Height="48" CornerRadius="4"
                                Background="{ThemeResource RhythmElevatedBrush}">
                            <SymbolIcon Symbol="MusicInfo"
                                        Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource RhythmTextPrimaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </views:LibraryTemplateSelector.AlbumTemplate>
            <views:LibraryTemplateSelector.TrackTemplate>
                <DataTemplate x:DataType="models:TrackItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4">
                        <Border Grid.Column="0" Width="{x:Bind Indent}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource RhythmTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Artist}"
                                       Visibility="{x:Bind HasArtist}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="4,1"
                                Margin="8,0"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{x:Bind SourceBackground}">
                            <TextBlock Text="{x:Bind SourceTag}"
                                       FontSize="10"
                                       Foreground="{x:Bind SourceForeground}" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </views:LibraryTemplateSelector.TrackTemplate>
        </views:LibraryTemplateSelector>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- #520: the by-letter index sits to the right of the list, as the
             macOS index column does; collapsed it takes no room. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- #502: the page's single view switch, a segmented control centred
             at the top and labelled like the macOS picker, with a divider
             under it. Segment labels and the selected one come from the view
             state; the selected segment swaps to the selected styles, whose
             colours are palette brushes (#219). -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <Border HorizontalAlignment="Center" Margin="12,8,12,8" Padding="2"
                    CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource RhythmBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton x:Name="segmentArtistAlbum" GroupName="LibraryViewSwitch"
                                 Style="{StaticResource SegmentButtonStyle}"
                                 Click="OnSegmentClick">
                        <Border x:Name="segmentArtistAlbumBack" Style="{StaticResource SegmentBackStyle}">
                            <TextBlock x:Name="segmentArtistAlbumLabel" Style="{StaticResource SegmentLabelStyle}" />
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="segmentByLetter" GroupName="LibraryViewSwitch"
                                 Style="{StaticResource SegmentButtonStyle}"
                                 Click="OnSegmentClick">
                        <Border x:Name="segmentByLetterBack" Style="{StaticResource SegmentBackStyle}">
                            <TextBlock x:Name="segmentByLetterLabel" Style="{StaticResource SegmentLabelStyle}" />
                        </Border>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border Height="1" Background="{ThemeResource RhythmBorderBrush}" />
        </StackPanel>

        <!-- #503: the list renders the lines the view state gives, one
             template per kind: a section heading, an album group heading with
             its cover placeholder, and a track row (title over artist, then
             source badge and duration, as macOS TrackRowView). Headings are
             not clickable; see OnContainerContentChanging. -->
        <ListView x:Name="trackList" Grid.Row="1"
                  SelectionMode="Single"
                  ItemClick="OnTrackClick"
                  IsItemClickEnabled="True"
                  ContainerContentChanging="OnContainerContentChanging"
                  SelectionChanged="OnSelectionChanged"
                  ItemTemplateSelector="{StaticResource LibraryTemplates}" />

        <!-- #520: the entries and the line each scrolls to come from the
             view state (LetterIndex); empty, the column is collapsed. -->
        <StackPanel x:Name="letterIndex" Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Top" Margin="0,4,4,0"
                    Visibility="Collapsed" />

        <StackPanel x:Name="emptyState" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="emptyMessage"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
            <TextBlock x:Name="emptyHint"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
