<Page
    x:Class="Rhythm.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Rhythm.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Pivot x:Name="viewPivot" Grid.Row="0" SelectionChanged="OnPivotChanged"
               Margin="12,4">
            <PivotItem x:Name="pivotArtistAlbum" />
            <PivotItem x:Name="pivotByLetter" />
        </Pivot>

        <ListView x:Name="trackList" Grid.Row="1"
                  SelectionMode="Single"
                  ItemClick="OnTrackClick"
                  IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TrackItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4">
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource RhythmTextPrimaryBrush}" />
                        <Border Grid.Column="2" Padding="4,1"
                                Margin="8,0"
                                CornerRadius="3"
                                Background="{x:Bind SourceBackground}">
                            <TextBlock Text="{x:Bind SourceTag}"
                                       FontSize="10"
                                       Foreground="{x:Bind SourceForeground}" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="emptyState" Grid.Row="1" Spacing="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="emptyMessage"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
            <TextBlock x:Name="emptyHint"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource RhythmTextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
