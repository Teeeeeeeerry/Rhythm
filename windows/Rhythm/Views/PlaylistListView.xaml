<Page
    x:Class="Rhythm.Views.PlaylistListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Rhythm.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="btnNewPlaylist" Grid.Row="0" Click="OnNewPlaylistClick"
                Margin="12,8" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <SymbolIcon Symbol="Add" />
                <TextBlock x:Name="newPlaylistText" />
            </StackPanel>
        </Button>

        <ListView x:Name="playlistList" Grid.Row="1"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnPlaylistClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,4">
                        <SymbolIcon Grid.Column="0" Symbol="List" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                   VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Column="2" FontSize="12"
                                   Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                                   Text="{x:Bind TrackCountText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="emptyMessage" Grid.Row="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                   Visibility="Collapsed" />
    </Grid>
</Page>
