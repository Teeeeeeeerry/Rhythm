<UserControl
    x:Class="Rhythm.Views.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="100" Background="{ThemeResource RhythmSurfaceBrush}"
          BorderBrush="{ThemeResource RhythmBorderBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <ProgressBar x:Name="progressBar" Grid.Row="0"
                     Minimum="0" Maximum="100" Value="0"
                     Height="4"
                     Foreground="{ThemeResource RhythmAccentBrush}" />

        <!-- #496: the controls sit in an Auto column so a narrow window never
             clips them; the two equal star columns keep them centred and give
             way first: the title truncates and the volume slider narrows. -->
        <Grid Grid.Row="1" Margin="16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="8" Margin="0,0,16,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4"
                        Background="{ThemeResource RhythmElevatedBrush}">
                    <SymbolIcon Symbol="MusicInfo" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            MaxWidth="180" HorizontalAlignment="Left">
                    <TextBlock x:Name="trackTitle"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="trackArtist" Text=""
                               FontSize="11"
                               Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- #496: the buttons size to their icon plus padding; a fixed
                 32px square left the default padding no room for the glyph. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <Button Padding="8" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="btnPlayPause" Padding="10" VerticalAlignment="Center"
                        Click="OnPlayPauseClick">
                    <SymbolIcon x:Name="playIcon" Symbol="Play" />
                </Button>
                <Button Padding="8" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Next" />
                </Button>
                <!-- #373: play mode control; tooltip text comes from the key
                     table (play_mode_tooltip), icon follows AppState.CurrentMode. -->
                <Button x:Name="btnPlayMode" Padding="8" VerticalAlignment="Center"
                        Click="OnPlayModeClick">
                    <SymbolIcon x:Name="playModeIcon" Symbol="List" />
                </Button>
            </StackPanel>

            <!-- #496: icon, slider and time text share one centred row; the
                 slider is the part that narrows when the column does. -->
            <Grid Grid.Column="2" ColumnSpacing="8" Margin="8,0,0,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" MaxWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SymbolIcon Grid.Column="1" Symbol="Volume" VerticalAlignment="Center" />
                <Slider x:Name="volumeSlider" Grid.Column="2" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" Value="100"
                        ValueChanged="OnVolumeChanged" />
                <TextBlock x:Name="timeText" Grid.Column="3" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                           Text="0:00 / 0:00" Width="80"
                           HorizontalTextAlignment="Right" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="urlBox"
                     KeyDown="OnUrlKeyDown" />
            <!-- First run downloads yt-dlp; show progress so it doesn't
                 look like the app has hung. -->
            <TextBlock x:Name="urlStatus" Grid.Column="1" Text=""
                       Margin="8,0,0,0" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" />
            <Button x:Name="btnUrlPlay" Grid.Column="2" Margin="8,0,0,0"
                    Click="OnUrlPlayClick" />
        </Grid>
    </Grid>
</UserControl>
