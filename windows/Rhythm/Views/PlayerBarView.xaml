<UserControl
    x:Class="Rhythm.Views.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="100" Background="{ThemeResource RhythmSurfaceBrush}"
          BorderBrush="{ThemeResource RhythmBorderBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <ProgressBar x:Name="progressBar" Grid.Row="0"
                     Minimum="0" Maximum="100" Value="0"
                     Height="4" />

        <Grid Grid.Row="1" Margin="16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Border Width="40" Height="40" CornerRadius="4"
                        Background="{ThemeResource RhythmElevatedBrush}">
                    <SymbolIcon Symbol="MusicInfo" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="trackTitle" Text="未在播放"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120" />
                    <TextBlock x:Name="trackArtist" Text=""
                               FontSize="11"
                               Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Spacing="12">
                <Button Width="32" Height="32" Style="{StaticResource Button}">
                    <SymbolIcon Symbol="Previous" />
                </Button>
                <Button x:Name="btnPlayPause" Width="40" Height="40"
                        Click="OnPlayPauseClick">
                    <SymbolIcon x:Name="playIcon" Symbol="Play" />
                </Button>
                <Button Width="32" Height="32" Style="{StaticResource Button}">
                    <SymbolIcon Symbol="Next" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <SymbolIcon Symbol="Volume" />
                <Slider x:Name="volumeSlider" Width="80"
                        Minimum="0" Maximum="100" Value="100"
                        ValueChanged="OnVolumeChanged" />
                <TextBlock x:Name="timeText" FontSize="11"
                           Foreground="{ThemeResource RhythmTextSecondaryBrush}"
                           Text="0:00 / 0:00" Width="80"
                           HorizontalTextAlignment="Right" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="urlBox"
                     PlaceholderText="粘贴 YouTube / Bilibili 链接播放"
                     KeyDown="OnUrlKeyDown" />
            <!-- First run downloads yt-dlp; show progress so it doesn't
                 look like the app has hung. -->
            <TextBlock x:Name="urlStatus" Grid.Column="1" Text=""
                       Margin="8,0,0,0" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="播放" Margin="8,0,0,0"
                    Click="OnUrlPlayClick" />
        </Grid>
    </Grid>
</UserControl>
