<?xml version="1.0" encoding="utf-8"?>
<!--
  The XAML shell's shared sources and build glue (#495), imported last by the
  app (Rhythm.vcxproj) and the L2 capture host (RhythmCapture.vcxproj). See
  RhythmShell.props for the import order.

  Items name their files through $(RhythmShellDir) so a project outside this
  directory compiles the same files. Each XAML page carries a Link equal to its
  path here: the markup compiler derives the ms-appx:/// URI and the generated
  header names from it, so they are identical in every project.

  Not listed here (each project brings its own): App.xaml with App.xaml.h/.cpp,
  the manifest, and ShellHost.cpp (where the library lives, whether a tray
  icon is installed).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClInclude Include="$(RhythmShellDir)pch.h" />
    <ClInclude Include="$(RhythmShellDir)MainWindow.xaml.h"><DependentUpon>$(RhythmShellDir)MainWindow.xaml</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)ShellHost.h" />
    <ClInclude Include="$(RhythmShellDir)Models\TrackItem.h"><DependentUpon>$(RhythmShellDir)Models\Items.idl</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Models\PlaylistItem.h"><DependentUpon>$(RhythmShellDir)Models\Items.idl</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Models\LibraryItems.h"><DependentUpon>$(RhythmShellDir)Models\Items.idl</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\LibraryTemplateSelector.h"><DependentUpon>$(RhythmShellDir)Views\LibraryTemplateSelector.idl</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\LibraryView.xaml.h"><DependentUpon>$(RhythmShellDir)Views\LibraryView.xaml</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\PlayerBarView.xaml.h"><DependentUpon>$(RhythmShellDir)Views\PlayerBarView.xaml</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\PlaylistDetailView.xaml.h"><DependentUpon>$(RhythmShellDir)Views\PlaylistDetailView.xaml</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\PlaylistListView.xaml.h"><DependentUpon>$(RhythmShellDir)Views\PlaylistListView.xaml</DependentUpon></ClInclude>
    <ClInclude Include="$(RhythmShellDir)Views\SystemTheme.h" />
    <ClInclude Include="$(RhythmShellDir)Views\Win32Interop.h" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="$(RhythmShellDir)MainWindow.xaml"><Link>MainWindow.xaml</Link></Page>
    <Page Include="$(RhythmShellDir)Themes\Colors.xaml"><Link>Themes\Colors.xaml</Link></Page>
    <Page Include="$(RhythmShellDir)Views\LibraryView.xaml"><Link>Views\LibraryView.xaml</Link></Page>
    <Page Include="$(RhythmShellDir)Views\PlayerBarView.xaml"><Link>Views\PlayerBarView.xaml</Link></Page>
    <Page Include="$(RhythmShellDir)Views\PlaylistDetailView.xaml"><Link>Views\PlaylistDetailView.xaml</Link></Page>
    <Page Include="$(RhythmShellDir)Views\PlaylistListView.xaml"><Link>Views\PlaylistListView.xaml</Link></Page>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(RhythmShellDir)pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="$(RhythmShellDir)MainWindow.xaml.cpp" />
    <ClCompile Include="$(RhythmShellDir)Models\TrackItem.cpp" />
    <ClCompile Include="$(RhythmShellDir)Models\PlaylistItem.cpp" />
    <ClCompile Include="$(RhythmShellDir)Models\LibraryItems.cpp" />
    <ClCompile Include="$(RhythmShellDir)Views\LibraryTemplateSelector.cpp" />
    <ClCompile Include="$(RhythmShellDir)Views\LibraryView.xaml.cpp" />
    <ClCompile Include="$(RhythmShellDir)Views\PlayerBarView.xaml.cpp" />
    <ClCompile Include="$(RhythmShellDir)Views\PlaylistDetailView.xaml.cpp" />
    <ClCompile Include="$(RhythmShellDir)Views\PlaylistListView.xaml.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <!-- Written by MarkupCompilePass2: type info plus every *.xaml.g.hpp
         (InitializeComponent, Connect, the generated wWinMain). -->
    <ClCompile Include="$(GeneratedFilesDir)XamlTypeInfo.g.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)XamlTypeInfo.Impl.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="$(RhythmShellDir)MainWindow.idl" />
    <Midl Include="$(RhythmShellDir)Models\Items.idl" />
    <Midl Include="$(RhythmShellDir)Views\LibraryView.idl" />
    <Midl Include="$(RhythmShellDir)Views\LibraryTemplateSelector.idl" />
    <Midl Include="$(RhythmShellDir)Views\PlayerBarView.idl" />
    <Midl Include="$(RhythmShellDir)Views\PlaylistDetailView.idl" />
    <Midl Include="$(RhythmShellDir)Views\PlaylistListView.idl" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(RhythmWebView2Dir)build\native\Microsoft.Web.WebView2.targets" Condition="'$(RhythmWebView2Dir)' != ''" />
  <Import Project="$(RhythmWindowsAppSDKDir)build\native\Microsoft.WindowsAppSDK.targets" Condition="'$(RhythmWindowsAppSDKDir)' != ''" />
  <Import Project="$(RhythmCppWinRTDir)build\native\Microsoft.Windows.CppWinRT.targets" Condition="'$(RhythmCppWinRTDir)' != ''" />
  <!-- The SDK's own copy of the VS target that hands the compiled .xbf files
       to PRI generation (AddProcessedXamlFilesToCopyLocal). -->
  <Import Project="$(RhythmWindowsAppSDKDir)build\Microsoft.WinUI.NET.Markup.Compiler.targets" Condition="'$(RhythmWindowsAppSDKDir)' != ''" />
  <!--
    The Windows App SDK ships the XAML compiler (MarkupCompilePass1/2) but not
    the glue that runs it inside a C++ build; Visual Studio's UWP/WinUI C++
    workload normally supplies that. Hooking the two passes here keeps the
    build on Build Tools + the pinned packages alone (ADR-0004):
      Pass1 (XAML -> *.xaml.g.h) before MIDL, Pass2 (type info, needs the
      app's winmd) after the C++/WinRT projection and before compiling.
  -->
  <PropertyGroup>
    <XamlGeneratedOutputPath>$(GeneratedFilesDir)</XamlGeneratedOutputPath>
    <BeforeMidlCompileTargets>MarkupCompilePass1;$(BeforeMidlCompileTargets)</BeforeMidlCompileTargets>
    <BeforeClCompileTargets>$(BeforeClCompileTargets);MarkupCompilePass2</BeforeClCompileTargets>
  </PropertyGroup>
  <!-- Pass2 reads the winmd references from WinMDReferenceToCompile, which
       only the workload glue fills in: hand it the platform and package
       winmds C++/WinRT already resolved. -->
  <Target Name="RhythmXamlWinMDReferences" BeforeTargets="MarkupCompilePass2"
          DependsOnTargets="GetCppWinRTPlatformWinMDReferences;GetCppWinRTDirectWinMDReferences">
    <ItemGroup>
      <WinMDReferenceToCompile Include="@(CppWinRTPlatformWinMDReferences);@(CppWinRTDirectWinMDReferences)" />
    </ItemGroup>
  </Target>
  <!-- C++/WinRT tags its XamlMetaDataProvider.cpp for a separate
       "XamlGenerated" compile pass that the workload glue runs; compile it
       with everything else instead. -->
  <Target Name="RhythmCompileXamlGenerated" AfterTargets="CppWinRTComputeXamlGeneratedCompileInputs">
    <ItemGroup>
      <ClCompile Condition="'%(ClCompile.CompilerIteration)' == 'XamlGenerated'">
        <CompilerIteration></CompilerIteration>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Target Name="RhythmRequireCMakeBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RhythmBehaviorProps)')"
           Text="Missing $(RhythmBehaviorProps). Build through `python scripts/tasks.py build` (or `tasks.py test` for the L2 capture host): the CMake configure and behaviour-library steps run before this project (ADR-0004)." />
  </Target>
  <Target Name="RhythmCopyCore" AfterTargets="Build">
    <Copy SourceFiles="$(RhythmCoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
