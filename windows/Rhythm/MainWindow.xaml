<Window
    x:Class="Rhythm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rhythm.Views"
    Title="Rhythm"
    MinWidth="800" MinHeight="500"
    Width="960" Height="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="navView"
            Grid.Row="0"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="MusicInfo" Content="资料库" Tag="Library" />
                <NavigationViewItem Icon="List" Content="播放列表" Tag="Playlists" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                            Margin="12,8,12,4">
                    <Button x:Name="btnImport" Click="OnImportClick" ToolTipService.ToolTip="导入文件夹">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                    <AutoSuggestBox
                        x:Name="searchBox"
                        PlaceholderText="搜索..."
                        Width="200"
                        QuerySubmitted="OnSearchSubmitted"
                        TextChanged="OnSearchTextChanged" />
                    <ComboBox x:Name="viewModeCombo"
                              SelectionChanged="OnViewModeChanged"
                              SelectedIndex="0">
                        <ComboBoxItem Content="按艺人/专辑" />
                        <ComboBoxItem Content="按首字母" />
                    </ComboBox>
                </StackPanel>

                <Frame x:Name="contentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <views:PlayerBarView x:Name="playerBar" Grid.Row="1" />
    </Grid>
</Window>
