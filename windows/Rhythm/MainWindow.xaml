<Window
    x:Class="Rhythm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Rhythm.Views"
    Title="Rhythm">

    <!-- #501: an always-expanded sidebar beside the content, laid out like
         the macOS split view: the sidebar runs the full height, the player
         bar sits under the content. No hamburger, no overlay, no icon-only
         state. Which entry is highlighted comes from the view state; the
         highlight swaps between the styles below, whose colours are palette
         brushes (#219). -->
    <Grid x:Name="rootGrid">
        <Grid.Resources>
            <!-- #516: radio buttons, so assistive technology reads which
                 entry is selected (selection item semantics), with pointer-over
                 and pressed states in palette brushes. Whether one is checked
                 still comes from the view state. -->
            <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="5">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource RhythmHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource RhythmPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarHighlightStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="SidebarHighlightSelectedStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource RhythmSelectionBrush}" />
            </Style>
            <Style x:Key="SidebarIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource RhythmTextPrimaryBrush}" />
            </Style>
            <Style x:Key="SidebarIconSelectedStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{ThemeResource RhythmAccentBrush}" />
            </Style>
            <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource RhythmTextPrimaryBrush}" />
            </Style>
            <Style x:Key="SidebarLabelSelectedStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource RhythmAccentBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <!-- The macOS sidebar column's ideal width (ContentView.swift). -->
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{ThemeResource RhythmSurfaceBrush}"
                BorderBrush="{ThemeResource RhythmBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="10,12" Spacing="2">
                <RadioButton x:Name="sideLibrary" GroupName="Sidebar"
                             Style="{StaticResource SidebarButtonStyle}"
                             Click="OnSidebarClick">
                    <Border x:Name="sideLibraryHighlight" CornerRadius="5" Padding="8,6"
                            Style="{StaticResource SidebarHighlightStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <SymbolIcon x:Name="sideLibraryIcon"
                                        Style="{StaticResource SidebarIconStyle}" />
                            <TextBlock x:Name="sideLibraryLabel" VerticalAlignment="Center"
                                       Style="{StaticResource SidebarLabelStyle}" />
                        </StackPanel>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="sidePlaylists" GroupName="Sidebar"
                             Style="{StaticResource SidebarButtonStyle}"
                             Click="OnSidebarClick">
                    <Border x:Name="sidePlaylistsHighlight" CornerRadius="5" Padding="8,6"
                            Style="{StaticResource SidebarHighlightStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <SymbolIcon x:Name="sidePlaylistsIcon"
                                        Style="{StaticResource SidebarIconStyle}" />
                            <TextBlock x:Name="sidePlaylistsLabel" VerticalAlignment="Center"
                                       Style="{StaticResource SidebarLabelStyle}" />
                        </StackPanel>
                    </Border>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- #502: the toolbar sits at the trailing end of the content's top
                 edge, import before search, as the macOS window toolbar does.
                 The file picker cannot take files and folders at once, so the
                 two imports stand side by side where macOS has its single "+",
                 and like it they show on the library page only (#516).
                 The view switch is not here: it lives once, on the library
                 page. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="12,8,12,4">
                <Button x:Name="btnImport" Click="OnImportClick">
                    <SymbolIcon Symbol="Add" />
                </Button>
                <Button x:Name="btnImportFile" Click="OnImportFileClick">
                    <SymbolIcon Symbol="Audio" />
                </Button>
                <!-- #516: stands in for the two imports while one runs, as the
                     macOS toolbar swaps "+" for a progress view. -->
                <ProgressRing x:Name="importProgress" Width="20" Height="20"
                              VerticalAlignment="Center" Margin="6,0"
                              IsActive="False" Visibility="Collapsed"
                              Foreground="{ThemeResource RhythmAccentBrush}" />
                <AutoSuggestBox
                    x:Name="searchBox"
                    Width="200"
                    QuerySubmitted="OnSearchSubmitted"
                    TextChanged="OnSearchTextChanged" />
            </StackPanel>

            <Frame x:Name="contentFrame" Grid.Row="1" />

            <views:PlayerBarView x:Name="playerBar" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
